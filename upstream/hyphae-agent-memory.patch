+            limit: 1,
+            fusion: None,
+            parent_dedupe: None,
+            rerank: None,
+            highlight: None,
+            autocut: None,
+            offset: 0,
+        },
+        limit: 1,
+    };
+    let mut context = proof_context(&session, 301);
+    context.logical_time_micros = 100;
+    let (response, artifact) = generate_native_operation_proof(
